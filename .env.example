# Copy to .env for local settings. Every value has a development default.

# PostgreSQL. Plain postgres:// URLs, as hosts hand them out, also work.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/invoice_api

# Signs session tokens. Use a long random value anywhere but your own machine.
SECRET_KEY=change-me-to-a-random-value-of-32-characters-or-more

# "production" refuses to start with a weak or default SECRET_KEY.
ENVIRONMENT=development

# Hours a session token stays valid.
SESSION_HOURS=12

# Browser origins allowed to call the API, as a JSON list.
CORS_ORIGINS=["http://localhost:3000","https://knightly95.github.io"]
